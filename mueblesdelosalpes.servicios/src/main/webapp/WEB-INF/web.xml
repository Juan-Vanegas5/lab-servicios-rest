<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>

    <!--
        Los servicios REST ya no se registran con el servlet de Jersey 1
        (com.sun.jersey...ServletContainer). GlassFish 4.1 trae su propio JAX-RS 2.0
        (Jersey 2), y la clase ApplicationConfig del paquete servicios lo activa con
        @ApplicationPath("webresources"). Las URL quedan iguales a las de la guía:
        http://localhost:8080/mueblesdelosalpes.servicios/webresources/...
    -->
</web-app>
